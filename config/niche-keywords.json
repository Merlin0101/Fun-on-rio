{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Fonte unica de palavras-chave do nicho, usada para validar itens da fila do Shozap e das campanhas em Mercado Livre, Shopee e Amazon. Editar aqui reflete em todos os canais.",
  "defaultMinDiscountPercent": 30,
  "categories": {
    "eletronicos_pc": {
      "label": "Eletronicos para computador",
      "keywords": ["teclado", "mouse", "fone de ouvido", "fone bluetooth", "notebook"],
      "requireKnownBrand": false
    },
    "tenis_marcas": {
      "label": "Tenis de marca",
      "keywords": ["tenis", "sneaker"],
      "requireKnownBrand": true,
      "brands": ["adidas", "nike", "vans", "puma", "lacoste"]
    },
    "academia_suplementos": {
      "label": "Academia e suplementos",
      "keywords": ["short academia", "whey protein", "whey", "creatina", "melatonina"],
      "requireKnownBrand": false
    },
    "limpeza_promocao": {
      "label": "Limpeza (somente em promocao)",
      "keywords": ["sabao em po", "omo", "amaciante"],
      "requireKnownBrand": false,
      "requirePromotion": true
    },
    "beleza": {
      "label": "Beleza e cuidados pessoais",
      "keywords": ["creme facial", "creme corporal", "creme para o corpo"],
      "requireKnownBrand": false
    }
  },
  "knownBrands": ["adidas", "nike", "vans", "puma", "lacoste", "omo"],
  "genericExcludeTerms": ["kit variado", "sortido", "generico", "diversos modelos", "sem marca"]
}
